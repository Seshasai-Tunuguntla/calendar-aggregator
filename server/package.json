{
  "name": "@calendar-aggregator/server",
  "version": "0.0.0",
  "private": true,
  "description": "Express 5 API: Google OAuth, calendar providers, availability and bookings",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node src/server.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "tokens:reencrypt": "node scripts/reencryptTokens.ts"
  },
  "dependencies": {
    "@calendar-aggregator/shared": "*",
    "@prisma/client": "^6.19.3",
    "cookie": "^1.1.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "temporal-polyfill": "^1.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1"
  }
}
