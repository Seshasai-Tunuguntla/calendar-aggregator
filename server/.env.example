# Copy to server/.env (gitignored) and fill in. Never commit real values or paste them anywhere.

# Local development database. Adjust the user if needed.
DATABASE_URL="postgresql://you@localhost:5432/calendar_aggregator"

# Google sign-in (optional locally: without these the demo still works and Google sign-in is
# off). docs/google-setup.md explains how to get each value.
# GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="..."
# APP_ORIGIN="http://localhost:5190"

# Random secrets of your own. Generate each with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# COOKIE_SIGNING_SECRET="..."
# Versioned token encryption keys, newest first: "2:<new key>,1:<old key>".
# TOKEN_ENCRYPTION_KEYS="1:..."
