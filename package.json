{
  "name": "calendar-aggregator",
  "private": true,
  "description": "Combine Google Calendars into real free time and share Calendly-style booking links",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "typecheck": "npm run typecheck --workspaces && tsc -p e2e/tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "test": "npm run test --workspaces",
    "build": "npm run build --workspace client",
    "check": "npm run typecheck && npm run lint && npm run contrast && npm test && npm run build",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "contrast": "npm run contrast --workspace client",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "screenshots": "playwright test -c e2e/screenshots.config.ts",
    "e2e:live": "playwright test -c e2e/live.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
