{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["oxc", "typescript", "unicorn", "import", "react", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-console": ["warn", { "allow": ["error", "warn", "info"] }],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "warn",
    "typescript/consistent-type-imports": "error",
    "react/react-in-jsx-scope": "off",
    "vitest/valid-expect": ["error", { "maxArgs": 2 }]
  },
  "env": {
    "es2024": true
  },
  "overrides": [
    {
      "files": ["server/**", "shared/**"],
      "env": { "node": true },
      "rules": {
        // Express 5 forwards rejected promises from async handlers to the error handler (tested in
        // server/tests/unit/errorHandler.test.ts), so this Express 4 warning doesn't apply.
        "oxc/no-async-endpoint-handlers": "off"
      }
    },
    {
      "files": ["client/**"],
      "env": { "browser": true },
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "temporal-polyfill",
                "message": "Keep Temporal off the client (~19 kB gzipped); format times with localParts from @calendar-aggregator/shared."
              },
              {
                "name": "@calendar-aggregator/shared/slots",
                "message": "The slot algorithm runs on the server; the client gets slots from the API."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "**/coverage/**"]
}
