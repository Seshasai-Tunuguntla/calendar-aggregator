{
  // Shared compiler settings. Every workspace extends this, so all three agree on how strict to be.
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // Strict mode, plus the checks strict doesn't include. noUncheckedIndexedAccess matters for the
    // slot algorithm: `intervals[i]` is typed `Interval | undefined`, so off-by-one reads can't hide.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,

    // The server runs .ts files directly with Node's built-in type stripping (no build step), which
    // only works for syntax that can be erased: no enums, namespaces or parameter properties.
    // These options make tsc reject anything Node couldn't run, and require `import type` for types.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,

    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  }
}
